# One Band remote agent per role. Create each in the Band UI (Agents -> New remote agent),
# then paste its Agent ID and API key here.
PLANNER_AGENT_ID=
PLANNER_API_KEY=
BUILDER_AGENT_ID=
BUILDER_API_KEY=
REVIEWER_AGENT_ID=
REVIEWER_API_KEY=
SECURITY_AGENT_ID=
SECURITY_API_KEY=

# Claude (used by every agent through band-sdk's AnthropicAdapter)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
# $/1M tokens for the cost line each agent posts (Sonnet 5.5 list price)
PRICE_IN=2
PRICE_OUT=10

# WarmPath FastAPI backend
WARMPATH_API=http://localhost:8000

# Only for self-hosted Band; leave unset for Band Cloud
# BAND_REST_URL=
# BAND_WS_URL=
