# One Band remote agent per role. Create each in the Band UI (Agents -> New remote agent),
# then paste its Agent ID and API key here.
PLANNER_AGENT_ID=
PLANNER_API_KEY=
BUILDER_AGENT_ID=
BUILDER_API_KEY=
REVIEWER_AGENT_ID=
REVIEWER_API_KEY=
SECURITY_AGENT_ID=
SECURITY_API_KEY=

# LLM backend: claude_sdk (Claude subscription via the local `claude` login / CLAUDE_CODE_OAUTH_TOKEN)
# or anthropic (API key). Default: claude_sdk when ANTHROPIC_API_KEY is empty, else anthropic.
BAND_LLM=
CLAUDE_SDK_MODEL=sonnet
# Server/sandbox only: long-lived subscription token from `claude setup-token` on your Mac (personal use; uses your plan limits)
CLAUDE_CODE_OAUTH_TOKEN=
# Only for BAND_LLM=anthropic
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
# $/1M tokens for the cost line each agent posts (Sonnet 5.5 list price)
PRICE_IN=2
PRICE_OUT=10

# Kindred FastAPI backend
KINDRED_API=http://localhost:8000

# Only for self-hosted Band; leave unset for Band Cloud
# BAND_REST_URL=
# BAND_WS_URL=
