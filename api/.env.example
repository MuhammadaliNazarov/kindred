# Every integration runs LIVE when its key is set and falls back to deterministic demo data when it isn't.
# Claude: ANTHROPIC_API_KEY -> Anthropic API; else the `claude` CLI (Claude Code login or CLAUDE_CODE_OAUTH_TOKEN) -> your subscription
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Server/sandbox only: token from `claude setup-token` on your Mac (personal use; uses your plan limits)
CLAUDE_CODE_OAUTH_TOKEN=
# claude-cli model alias/id and timeout; LLM_PROVIDER=anthropic|claude-cli|fallback forces a mode
CLAUDE_CLI_MODEL=sonnet
CLAUDE_CLI_TIMEOUT=90
LLM_PROVIDER=
TAVILY_API_KEY=
SERPER_API_KEY=
HUNTER_API_KEY=
APOLLO_API_KEY=
SENDGRID_API_KEY=
SENDGRID_FROM=
# ALL sends are forced to this address (never the prospect). Without it, sends are simulated.
DEMO_INBOX=
FLEXPRICE_API_KEY=
FLEXPRICE_CUSTOMER_ID=
FLEXPRICE_BASE_URL=https://us.api.flexprice.io/v1
# Starting balance of the local fallback wallet (set 3 to show "Enrichment paused — out of credits" on camera)
DEMO_CREDITS=400
# Band (placeholder, not wired yet)
BAND_API_KEY=
BAND_ROOM=
CORS_ORIGIN=http://localhost:3000
# optional, e.g. https://.*\.tenki\..*  for preview URLs
CORS_ORIGIN_REGEX=
